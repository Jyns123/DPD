  {
   "id": "vt4gawdortvnzl8e",
   "seed": 1673293803,
   "version": 1,
   "versionNonce": 2137154229,
   "isDeleted": false,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": [],
