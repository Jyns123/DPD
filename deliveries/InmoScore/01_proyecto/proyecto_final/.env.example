# Optional settings; defaults work without an .env file.
DB_DRIVER=sqlite
SQLITE_PATH=storage/inmoscore.sqlite
# Set true only behind HTTPS; keep false for local HTTP.
SESSION_COOKIE_SECURE=false
# Docker Compose: puerto público y horario diario en Lima.
APP_PORT=8080
REFRESH_ENABLED=true
REFRESH_TIME=06:30

# Métricas optativas, separadas de las cuentas y del escenario simulado.
ANALYTICS_PATH=storage/analytics.sqlite
# En una instalación publicada, define una clave larga solo en el servidor.
# La lectura real fuera de localhost queda cerrada sin esta configuración.
# ANALYTICS_ADMIN_TOKEN=
# Ruta opcional a Python 3.10+ para la tendencia y el mapa de calor del tablero BI.
# PYTHON_EXECUTABLE=
# El lanzador habilita lectura sin clave solo si escucha en loopback.
# Al usar --hostname 0.0.0.0 o Docker, la clave es obligatoria.
# No definir ANALYTICS_LOCAL_ONLY manualmente en un servidor publicado.
